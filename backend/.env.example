OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# LadybugDB's per-connection buffer pool cap (app/graph/graphdb.py). Default
# (256MB) started failing chat/expand_hops queries with "Buffer manager
# exception: Unable to allocate memory!" once enough documents' node/edge
# tables accumulated in the shared graph DB -- raised now that the podman
# machine has 6GB to spare (see CLAUDE.md's "Running the full stack").
LADYBUG_BUFFER_POOL_SIZE=1073741824

# Optional: gates the whole API behind a single shared password (app/utils/auth.py,
# app/main.py). Unset (the default) means no auth at all -- every route is open,
# which is fine for local podman-compose dev but not for a public deploy (e.g.
# Render). When set, all routes except /health and the login endpoint require a
# bearer token obtained by POSTing this password.
# APP_PASSWORD=

# Optional: comma-separated list of origins the backend's CORS middleware allows
# (app/main.py). Defaults to the podman-compose frontend dev server's own origin --
# only needs overriding when the frontend is served from somewhere else.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: minimum confidence tier ("LOW", "MEDIUM", or "HIGH") a node/edge must
# have to be included in GraphRAG search results (app/graph/graphrag.py). Unset
# (the default) applies no filtering -- nodes/edges written before this field
# existed have no confidence value and must always pass regardless of this
# threshold, so a stricter-than-intended default here would silently drop them.
# GRAPHRAG_MIN_CONFIDENCE=

# Optional: cap on concurrent LLM calls when generating a schema across multiple
# chunk groups (app/ontology/generate_schema.py). Default 5.
# MAX_CONCURRENT_LLM_CALLS=5

# Optional: character budget for a whole document sent to the LLM in one call
# (discover_ontology/generate_schema, app/ontology/utils.py). Default 1000000.
# MAX_DOCUMENT_CHARS=1000000

# Optional: character budget per group when packing a chunked document's articles
# for the map/reduce discovery/schema/extract pipelines (app/ontology/utils.py).
# Default 12000.
# MAX_CHUNK_GROUP_CHARS=12000

# Optional: LLM tracing via a self-hosted Langfuse server (see
# docs/LANGFUSE.md). Leave unset to disable tracing entirely.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://host.containers.internal:3000
